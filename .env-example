# Local development. Copy to .env; keep real secrets out of version control.
NODE_ENV=development
PORT=3000
SESSION_SECRET=local-development-only-change-before-deploying
# Leave empty locally to retain compatibility with existing encrypted tokens.
TOKEN_ENCRYPTION_KEY=
PUBLIC_ORIGIN=
TRUST_PROXY=0

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ticket_mail
POSTGRES_USER=ticket_mail
POSTGRES_PASSWORD=local-development-password
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C
POSTGRES_CONTAINER_NAME=ticket-mail-postgres
POSTGRES_DATA_PATH=/var/lib/postgresql
POSTGRES_VOLUME_NAME=ticket_mail_postgres_data
POSTGRES_NETWORK_NAME=ticket_mail_postgres_network

# Start with offline demo tickets; use oauth for a real personal Outlook account.
GRAPH_AUTH_MODE=disabled
GRAPH_TENANT_ID=consumers
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_OWNER_EMAIL=manager@example.test
GRAPH_REDIRECT_URI=http://localhost:3000/emails/connection/callback
# Temporary Graph Explorer development mode only:
GRAPH_ACCESS_TOKEN=

LOCAL_MAILBOX=demo@example.test
LOCAL_OWNER_EMAIL=manager@example.test
