# Local development. Copy to .env; keep real secrets out of version control.
NODE_ENV=development
PORT=3000
SESSION_SECRET=local-development-only-change-before-deploying
# Encrypts stored mailbox credentials. Falls back to SESSION_SECRET when empty.
TOKEN_ENCRYPTION_KEY=
PUBLIC_ORIGIN=
# How many reverse proxies may set X-Forwarded-For (0 = none; 1 = Caddy in front of the app).
TRUST_PROXY=0
# fatal, error, warn, info (default), debug, trace or silent. Logs are JSON lines on stdout.
LOG_LEVEL=info

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mailbridge
POSTGRES_USER=mailbridge
POSTGRES_PASSWORD=local-development-password
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C
POSTGRES_CONTAINER_NAME=mailbridge-postgres
POSTGRES_DATA_PATH=/var/lib/postgresql
POSTGRES_VOLUME_NAME=mailbridge_postgres_data
POSTGRES_NETWORK_NAME=mailbridge_postgres_network

# pgAdmin (database browser) at http://localhost:5050. The database password is POSTGRES_PASSWORD.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=local-development-password
PGADMIN_PORT=5050
PGADMIN_CONTAINER_NAME=mailbridge-pgadmin
PGADMIN_VOLUME_NAME=mailbridge_pgadmin_data

# Public address of this app. Leave empty locally (defaults to http://localhost:PORT).
# OAuth redirect URIs to register: <PUBLIC_ORIGIN>/accounts/callback/outlook and /accounts/callback/gmail
ALLOW_REGISTRATION=true

# Optional. Without these the Connect buttons for that provider are disabled.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only these sign-in emails see the Gmail option (comma-separated). Empty = everyone.
GMAIL_ALLOWED_EMAILS=

# Password reset emails. These defaults send to Mailpit (docker compose up -d mailpit), which shows
# every message at http://localhost:8025 and delivers nothing to real inboxes.
# With SMTP_HOST empty, reset links are printed to the server log instead (development only).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mailbridge <no-reply@mailbridge.example>
