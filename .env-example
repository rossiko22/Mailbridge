# Local development. Copy to .env; keep real secrets out of version control.
NODE_ENV=development
PORT=3000
SESSION_SECRET=local-development-only-change-before-deploying
# Encrypts stored mailbox credentials. Falls back to SESSION_SECRET when empty.
TOKEN_ENCRYPTION_KEY=
PUBLIC_ORIGIN=
TRUST_PROXY=0

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ticket_mail
POSTGRES_USER=ticket_mail
POSTGRES_PASSWORD=local-development-password
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C
POSTGRES_CONTAINER_NAME=ticket-mail-postgres
POSTGRES_DATA_PATH=/var/lib/postgresql
POSTGRES_VOLUME_NAME=ticket_mail_postgres_data
POSTGRES_NETWORK_NAME=ticket_mail_postgres_network

# Public address of this app. Leave empty locally (defaults to http://localhost:PORT).
# OAuth redirect URIs to register: <PUBLIC_ORIGIN>/accounts/callback/outlook and /accounts/callback/gmail
ALLOW_REGISTRATION=true

# Optional. Without these the Connect buttons for that provider are disabled.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only these sign-in emails see the Gmail option (comma-separated). Empty = everyone.
GMAIL_ALLOWED_EMAILS=

# Optional. Without SMTP, password reset links are printed to the server log in development only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
