# Copy to .env.production and replace every placeholder. Never commit .env.production.
NODE_ENV=production
PORT=3000
APP_DOMAIN=mailbridge.your-domain.example
PUBLIC_ORIGIN=https://mailbridge.your-domain.example
ACME_EMAIL=operations@your-domain.example
# How many reverse proxies may set X-Forwarded-For (0 = none; 1 = Caddy in front of the app).
TRUST_PROXY=1
# fatal, error, warn, info (default), debug, trace or silent. Logs are JSON lines on stdout.
LOG_LEVEL=info
# Generate each independently: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_ENCRYPTION_KEY
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mailbridge
POSTGRES_USER=mailbridge
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD

ALLOW_REGISTRATION=true

# Redirect URIs to register with each provider:
#   https://mailbridge.your-domain.example/accounts/callback/outlook
#   https://mailbridge.your-domain.example/accounts/callback/gmail
# Leave a provider's pair empty to disable it. Setting only one of the pair is an error.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only these sign-in emails see the Gmail option (comma-separated). Empty = everyone.
GMAIL_ALLOWED_EMAILS=

# Needed for password reset emails. Without it, reset links are not delivered.
SMTP_HOST=smtp.your-domain.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="Mailbridge <no-reply@your-domain.example>"
