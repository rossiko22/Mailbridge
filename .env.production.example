# Copy to .env.production and replace every placeholder. Never commit .env.production.
NODE_ENV=production
PORT=3000
APP_DOMAIN=tickets.your-domain.example
PUBLIC_ORIGIN=https://tickets.your-domain.example
ACME_EMAIL=operations@your-domain.example
TRUST_PROXY=1
# Generate each independently: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_RANDOM_ENCRYPTION_KEY
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ticket_mail
POSTGRES_USER=ticket_mail
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD

# Personal Outlook.com/Hotmail: oauth + consumers.
# Work/school delegated mailbox: oauth + tenant UUID.
# Microsoft 365 app-only/shared mailbox: application + tenant UUID.
GRAPH_AUTH_MODE=oauth
GRAPH_TENANT_ID=consumers
GRAPH_CLIENT_ID=REPLACE_WITH_APPLICATION_CLIENT_ID
GRAPH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET_VALUE
GRAPH_MAILBOX=your-mailbox@outlook.com
# Existing local ticketing application account; provision with admin:create.
GRAPH_OWNER_EMAIL=administrator@your-domain.example
GRAPH_REDIRECT_URI=https://tickets.your-domain.example/emails/connection/callback
GRAPH_ACCESS_TOKEN=
